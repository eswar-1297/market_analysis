# ============================================================================
#  CloudFuze Marketing Dashboard — environment config
#  Copy this file to ".env" and fill in the values. NEVER commit .env.
#  Any blank source falls back to realistic SAMPLE data.
# ============================================================================

# --- Server ---
PORT=4000

# --- Dashboard login ---
DASHBOARD_USER=CFMARKETING
DASHBOARD_PASS=change-me

# --- Google Analytics 4 ---
# Numeric property ID (GA4 report URL: a<account>p<PROPERTY_ID>).
GA4_PROPERTY_ID=

# --- Google Search Console ---
# Exact property string, e.g. https://www.cloudfuze.com/  or  sc-domain:cloudfuze.com
SEARCH_CONSOLE_SITE_URL=

# --- Service-account credentials (GA4 + Search Console) ---
# DEPLOYMENT-FRIENDLY: base64 of the whole service-account JSON key, one line.
#   Generate:  base64 -w0 key.json     (or: certutil -encode / PowerShell)
GOOGLE_CREDENTIALS_B64=
# Alternative for local dev: absolute path to the JSON key file instead.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- PageSpeed Insights / CrUX (real Core Web Vitals) ---
PAGESPEED_API_KEY=
# Which profile the Perf. column measures: desktop (default) or mobile. Must match
# the tab you compare against on pagespeed.web.dev — the two are separate
# measurements and their scores are not comparable. Changing this discards the
# stored scores and re-measures every page under the new profile.
# PAGESPEED_STRATEGY=desktop
# Local hour (0-23) of the daily pre-measure. Every page is measured once here so
# the Perf. column loads from that snapshot instead of measuring on each visit.
# PAGESPEED_REFRESH_HOUR=7

# --- Hotjar (session recording + heatmaps) ---
# Site ID, digits only (Hotjar -> Settings -> Sites & Organizations). Blank disables
# Hotjar entirely: no script is requested and no session is recorded.
# NOT a secret -- it ships inside the client-side JavaScript bundle, so it belongs in a
# plain variable rather than a secret store.
#
# Local dev: Vite reads this as VITE_HOTJAR_SITE_ID, so to try Hotjar locally either
# export VITE_HOTJAR_SITE_ID=<id> before `npm run dev`, or set hotjarSiteId in
# client/public/runtime-config.js (which needs no rebuild).
#
# Production does NOT read this file -- it reads the HOTJAR_SITE_ID repository variable
# in GitHub Actions, which .deploy/deploy-build.sh forwards to the Docker build.
HOTJAR_SITE_ID=
